<?xml version="1.0" encoding="utf-8"?>
<!-- The HUD sits over video, which is dark in both themes, so its colours do
     not follow the system theme. -->
<resources>
    <color name="video_background">#FF000000</color>
    <color name="hud_scrim">#F01E1E1E</color>
    <color name="bar_scrim">#E61E1E1E</color>
    <color name="hud_text">#FFFFFFFF</color>
    <color name="hud_text_secondary">#FFB8C0CC</color>
    <color name="hud_tile">#26FFFFFF</color>
    <color name="hud_tile_active">#FF3B6FD8</color>
    <!-- The stats charts' line: the dark-surface blue, over 4.5:1 on hud_scrim. -->
    <color name="hud_chart_line">#FF3987E5</color>
    <color name="hud_danger">#FFFF8A80</color>
    <!-- Group titles in the stats panel, over 4.5:1 on hud_scrim. -->
    <color name="hud_heading">#FFA8C7FA</color>
    <!-- Follows the theme: values-night has a lighter green for dark surfaces. -->
    <color name="health_online">#FF2E7D32</color>
    <!-- Link quality dots in the stats overlay, readable on the dark scrim. -->
    <color name="quality_excellent">#FF66BB6A</color>
    <color name="quality_good">#FF9CCC65</color>
    <color name="quality_fair">#FFFFCA28</color>
    <color name="quality_poor">#FFEF5350</color>
</resources>
